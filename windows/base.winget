# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
#
# Base Windows setup, safe on ANY machine (home or work): PowerShell 7 + chezmoi.
# Run from an elevated PowerShell (one-time first: winget configure --enable):
#   winget configure -f <this file> --accept-configuration-agreements
# Then, as a normal user: chezmoi init ryanmatthes  (answers home/work + git email)
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
- type: Microsoft.WinGet/Package
  name: PowerShell7
  properties:
    id: Microsoft.PowerShell
    source: winget
  metadata:
    description: Install PowerShell 7 (needed for the module steps below)
    winget:
      securityContext: elevated
- type: Microsoft.WinGet/Package
  name: Chezmoi
  properties:
    id: twpayne.chezmoi
    source: winget
  metadata:
    description: Install chezmoi (dotfiles; then `chezmoi init --apply ryanmatthes` as a normal user)
