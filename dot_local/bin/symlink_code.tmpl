{{- /* VS Code CLI: per-user install (home, work desktop) or system install (work laptop). /mnt/c is case-insensitive, so the Linux username matches the Windows one. */ -}}
{{- $user := printf "/mnt/c/Users/%s/AppData/Local/Programs/Microsoft VS Code/bin/code" .chezmoi.username -}}
{{- if stat $user }}{{ $user }}{{ else }}/mnt/c/Program Files/Microsoft VS Code/bin/code{{ end -}}
